# Copie este arquivo para .env e preencha com valores reais.
# Nunca commite o arquivo .env real.

# --- Orquestração ---
# Decisão em aberto: Airflow (Docker Compose) vs script próprio de orquestração.
# false = orquestração ainda não decidida / não usar Airflow por enquanto
USE_AIRFLOW=false


# --- Dados ---
DATA_RAW_PATH=data/raw/transacoes.csv
DATA_PROCESSED_PATH=data/processed/

# --- Logging ---
LOG_LEVEL=INFO
LOG_FILE_PATH=logs/pipeline.log

# --- Airflow / Banco de dados ---
AIRFLOW__CORE__EXECUTOR=LocalExecutor
POSTGRES_USER=airflow
POSTGRES_PASSWORD=airflow
POSTGRES_DB=airflow

# --- Dashboard ---
STREAMLIT_SERVER_PORT=8501
